---
// A single case-study listing card (ADR-001). Links to the deep-dive page at
// /work/<id>. Reads a typed `work` collection entry.
import type { CollectionEntry } from "astro:content";

interface Props {
  /** A `work` collection entry. */
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { title, summary, role, period, metrics } = entry.data;
---

<a href={`/work/${entry.id}`} class="cv-card">
  <h3 class="cv-entry-title text-fg">{title}</h3>
  <p class="cv-meta mt-1">{role} · {period}</p>
  <p class="cv-body mt-3 text-muted">{summary}</p>
  {
    metrics.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {metrics.map((metric) => (
          <li class="cv-badge text-muted">{metric}</li>
        ))}
      </ul>
    )
  }
</a>
