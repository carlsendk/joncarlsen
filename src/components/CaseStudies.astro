---
// "Selected Work" listing section (ADR-001). Queries the `work` collection,
// keeps only featured, non-draft entries (the depth tier — ADR-002/003), sorts
// by `order`, and renders a card per case study. The full set lives on the
// /work index, linked below. Shared by the frontpage and /cv so the listing
// logic lives in one place. Renders nothing when there are no featured entries.
import { getCollection } from "astro:content";
import CaseStudyCard from "./CaseStudyCard.astro";

const entries = (
  await getCollection("work", ({ data }) => data.featured && !data.draft)
).sort((a, b) => a.data.order - b.data.order);
---

{
  entries.length > 0 && (
    <section aria-labelledby="work-heading" class="reveal mx-auto max-w-2xl border-t border-border px-6 py-14">
      <h2 id="work-heading" class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-muted">
        Selected Work
      </h2>
      <ul class="mt-8 space-y-4">
        {entries.map((entry) => (
          <li>
            <CaseStudyCard entry={entry} />
          </li>
        ))}
      </ul>
      <a
        href="/work"
        class="link-underline mt-8 inline-flex font-mono text-xs uppercase tracking-wider text-muted motion-safe:transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        See all work, grouped by company →
      </a>
    </section>
  )
}
