---
// Spare-time interests for the full CV (/cv only, ADR-003). Reads
// cvData.interests. Renders labels as a scannable list; themes are selection
// metadata, not shown in the MVP UI. Renders nothing when there are no
// interests, consistent with the other guarded sections.
import type { Interest } from "../data/cv.ts";

interface Props {
  /** Spare-time interests. */
  interests: Interest[];
}

const { interests } = Astro.props;
---

{
  interests.length > 0 && (
    <section aria-labelledby="interests-heading" class="reveal cv-section">
      <h2 id="interests-heading" class="cv-eyebrow">
        Interests
      </h2>
      <ul class="cv-body mt-8 space-y-2 text-muted">
        {interests.map((interest) => <li>{interest.label}</li>)}
      </ul>
    </section>
  )
}
