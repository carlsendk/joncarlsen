---
import "../styles/global.css";

interface Props {
  /** Page <title> and Open Graph title. */
  title: string;
  /** Meta description and Open Graph description. */
  description: string;
  /** Optional absolute URL of a social share image. */
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Preload the above-the-fold display face (hero); JetBrains Mono loads
         on demand via font-display: swap. Self-hosted, same-origin (ADR-002). -->
    <link
      rel="preload"
      href="/fonts/fraunces-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
  </head>
  <body class="bg-white text-slate-900 antialiased">
    <slot />
  </body>
</html>
