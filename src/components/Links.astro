---
// Renders outbound profile links and an optional PDF résumé download. This is
// the only path off the page (ADR-001). No contact form or contact details
// (ADR-002) — outbound profile links only.
import type { ProfileLink } from "../data/cv.ts";

interface Props {
  /** Outbound profile links. */
  links: ProfileLink[];
  /** Optional path to a downloadable résumé under public/; omit to hide the download. */
  resumePdf?: string;
}

const { links, resumePdf } = Astro.props;

/** External links open in a new tab and need rel="noopener" for security. */
const isExternal = (url: string) => /^https?:\/\//i.test(url) || url.startsWith("//");
---

<section aria-labelledby="links-heading" class="reveal mx-auto max-w-2xl border-t border-border px-6 py-14 pb-24">
  <h2 id="links-heading" class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-muted">
    Links
  </h2>
  <ul class="mt-8 flex flex-wrap gap-3">
    {
      links.map((link) => (
        <li>
          <a
            href={link.url}
            class="inline-flex items-center rounded-full border border-border px-4 py-2 font-mono text-sm text-fg motion-safe:transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            {...(isExternal(link.url)
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
  {
    resumePdf && (
      <p class="mt-8">
        <a
          href={resumePdf}
          download
          class="inline-flex items-center rounded-full bg-accent px-5 py-2.5 font-mono text-sm font-medium text-bg motion-safe:transition-colors hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Download résumé (PDF)
        </a>
      </p>
    )
  }
</section>
