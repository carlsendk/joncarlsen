---
// Renders selected achievements, each led by a quantified result. The metric
// is rendered BEFORE its summary so the number leads (PRD "Impact highlights").
import type { Highlight } from "../data/cv.ts";

interface Props {
  /** Quantified impact highlights. */
  highlights: Highlight[];
}

const { highlights } = Astro.props;
---

<section aria-labelledby="impact-heading" class="mx-auto max-w-2xl border-t border-slate-100 px-6 py-12">
  <h2 id="impact-heading" class="text-sm font-semibold uppercase tracking-wider text-slate-500">
    Impact
  </h2>
  <ul class="mt-6 space-y-8">
    {
      highlights.map((highlight) => (
        <li>
          <p class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
            {highlight.metric}
          </p>
          <p class="mt-2 max-w-prose text-base leading-relaxed text-slate-600">
            {highlight.summary}
          </p>
        </li>
      ))
    }
  </ul>
</section>
