---
// Renders selected achievements, each led by a quantified result. The metric
// is rendered BEFORE its summary so the number leads (PRD "Impact highlights").
import type { Highlight } from "../data/cv.ts";

interface Props {
  /** Quantified impact highlights. */
  highlights: Highlight[];
}

const { highlights } = Astro.props;
---

<section aria-labelledby="impact-heading" class="mx-auto max-w-2xl border-t border-border px-6 py-14">
  <h2 id="impact-heading" class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-muted">
    Impact
  </h2>
  <ul class="mt-8 space-y-10">
    {
      highlights.map((highlight) => (
        <li>
          <p class="font-display text-5xl font-semibold tracking-tight text-accent sm:text-6xl">
            {highlight.metric}
          </p>
          <p class="mt-2 max-w-prose leading-relaxed text-muted">
            {highlight.summary}
          </p>
        </li>
      ))
    }
  </ul>
</section>
