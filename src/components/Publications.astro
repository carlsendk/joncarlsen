---
// Publications and honours for the full CV. Reads cvData.publications; each item
// optionally deep-links to its backing work case study at /work/<slug>.
import type { Publication } from "../data/cv.ts";

interface Props {
  /** Publications and honours. */
  publications: Publication[];
}

const { publications } = Astro.props;
---

{
  publications.length > 0 && (
    <section aria-labelledby="publications-heading" class="reveal mx-auto max-w-2xl border-t border-border px-6 py-14">
      <h2 id="publications-heading" class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-muted">
        Publications & Honours
      </h2>
      <ul class="mt-8 space-y-2 leading-relaxed text-muted">
        {publications.map((item) =>
          item.work ? (
            <li>
              <a
                href={`/work/${item.work}`}
                class="link-underline motion-safe:transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              >
                {item.label}
              </a>
            </li>
          ) : (
            <li>{item.label}</li>
          ),
        )}
      </ul>
    </section>
  )
}
