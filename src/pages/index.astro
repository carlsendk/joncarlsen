---
// Frontpage (/) — the short, scannable hub of the hub-and-spoke structure
// (ADR-001). Tuned to the 7-8s recruiter scan: identity, quantified proof,
// expertise, a condensed teaser of recent roles, and one clear path to the full
// CV. The complete history lives on /cv (ADR-001); a single leadership identity
// leads (ADR-002). Reads only the subset of cvData it needs.
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Summary from "../components/Summary.astro";
import Impact from "../components/Impact.astro";
import Expertise from "../components/Expertise.astro";
import Timeline from "../components/Timeline.astro";
import CaseStudies from "../components/CaseStudies.astro";
import Links from "../components/Links.astro";
import { cvData } from "../data/cv.ts";
import { leadImpactItems } from "../lib/impact.ts";

// Metadata is single-sourced from cvData so the owner edits one file (ADR-003).
const title = `${cvData.name} · CV`;
const description = cvData.valueProp;

// Impact band derives from the work collection (first metric per company, ADR-004).
const leadImpact = await leadImpactItems();
---

<Base title={title} description={description}>
  <Hero
    name={cvData.name}
    title={cvData.title}
    valueProp={cvData.valueProp}
    scope={cvData.scope}
  />
  <main>
    <Summary summary={cvData.summary} />
    <Impact items={leadImpact} />
    <Expertise expertise={cvData.expertise} />
    <Timeline roles={cvData.roles} variant="condensed" limit={4} />
    <CaseStudies />
    <div class="mx-auto max-w-2xl px-6 pt-2">
      <a
        href="/cv"
        class="cv-pill-solid"
      >
        View full CV →
      </a>
    </div>
    <Links links={cvData.links} resumePdf={cvData.resumePdf} />
  </main>
</Base>
