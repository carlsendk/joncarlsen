---
// Education for the full CV. Reads cvData.education (newest first).
import type { Education } from "../data/cv.ts";

interface Props {
  /** Degrees, newest first. */
  education: Education[];
  /** Optional one-line orientation rendered under the heading. */
  leadIn?: string;
}

const { education, leadIn } = Astro.props;
---

<section id="education" aria-labelledby="education-heading" class="reveal cv-section">
  <h2 id="education-heading" class="cv-eyebrow">
    Education
  </h2>
  {leadIn && <p class="cv-lead">{leadIn}</p>}
  <ul class="mt-8 space-y-6">
    {
      education.map((entry) => (
        <li>
          <h3 class="cv-entry-title text-fg">{entry.degree}</h3>
          <p class="cv-body mt-0.5 text-fg">{entry.institution}</p>
          <p class="cv-meta mt-1">{entry.start} – {entry.end}</p>
          {entry.activities && entry.activities.length > 0 && (
            <ul class="cv-detail mt-2 space-y-1 text-muted">
              {entry.activities.map((activity) => <li>{activity}</li>)}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</section>
