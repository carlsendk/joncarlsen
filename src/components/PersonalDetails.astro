---
// Personal details for the full CV (Danish CV norm). Reads cvData.personalDetails.
// The PersonalDetails type carries no contact field, so no email/phone can be
// rendered here (ADR-002).
import type { PersonalDetails } from "../data/cv.ts";

interface Props {
  /** Date of birth, nationality, marital status. */
  details: PersonalDetails;
  /** Optional one-line orientation rendered under the heading. */
  leadIn?: string;
}

const { details, leadIn } = Astro.props;
---

<section id="personal" aria-labelledby="personal-heading" class="reveal cv-section">
  <h2 id="personal-heading" class="cv-eyebrow">
    Personal Details
  </h2>
  {leadIn && <p class="cv-lead">{leadIn}</p>}
  <dl class="mt-8 space-y-2">
    <div class="flex items-baseline gap-3">
      <dt class="cv-meta w-28 shrink-0">Born</dt>
      <dd class="cv-body text-fg">{details.dob}</dd>
    </div>
    <div class="flex items-baseline gap-3">
      <dt class="cv-meta w-28 shrink-0">Nationality</dt>
      <dd class="cv-body text-fg">{details.nationality}</dd>
    </div>
    <div class="flex items-baseline gap-3">
      <dt class="cv-meta w-28 shrink-0">Status</dt>
      <dd class="cv-body text-fg">{details.maritalStatus}</dd>
    </div>
  </dl>
</section>
