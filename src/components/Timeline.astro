---
// Renders the chronological experience timeline: one entry per role
// (company, position, dates, team scope). Maps to PRD "Experience timeline".
import type { Role } from "../data/cv.ts";

interface Props {
  /** Roles, newest first. */
  roles: Role[];
}

const { roles } = Astro.props;
---

<section aria-labelledby="experience-heading" class="reveal mx-auto max-w-2xl border-t border-border px-6 py-14">
  <h2 id="experience-heading" class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-muted">
    Experience
  </h2>
  <ol class="mt-8 space-y-10">
    {
      roles.map((role) => (
        <li class="border-l border-border pl-5">
          <h3 class="font-display text-xl font-semibold tracking-tight text-fg">{role.position}</h3>
          <p class="mt-0.5 text-base text-fg">{role.company}</p>
          <p class="mt-1.5 font-mono text-xs uppercase tracking-wider text-muted">{role.start} – {role.end}</p>
          <p class="mt-3 leading-relaxed text-muted">{role.scope}</p>
        </li>
      ))
    }
  </ol>
</section>
