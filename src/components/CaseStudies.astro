---
// "Selected Work" listing section (ADR-001). Queries the `work` collection,
// keeps only featured, non-draft entries (the depth tier — ADR-002/003), sorts
// by `order`, and renders a card per case study. The full set lives on the
// /work index, linked below. Shared by the frontpage and /cv so the listing
// logic lives in one place. Renders nothing when there are no featured entries.
import { getCollection } from "astro:content";
import CaseStudyCard from "./CaseStudyCard.astro";

interface Props {
  /** Optional one-line orientation rendered under the heading. */
  leadIn?: string;
}

const { leadIn } = Astro.props;

const entries = (
  await getCollection("work", ({ data }) => data.featured && !data.draft)
).sort((a, b) => a.data.order - b.data.order);
---

{
  entries.length > 0 && (
    <section id="work" aria-labelledby="work-heading" class="reveal cv-section">
      <h2 id="work-heading" class="cv-eyebrow">
        Selected Work
      </h2>
      {leadIn && <p class="cv-lead">{leadIn}</p>}
      <ul class="mt-8 space-y-4">
        {entries.map((entry) => (
          <li>
            <CaseStudyCard entry={entry} />
          </li>
        ))}
      </ul>
      <a
        href="/work"
        class="cv-link link-underline mt-8 inline-flex font-mono text-xs uppercase tracking-wider text-muted"
      >
        See all work, grouped by company →
      </a>
    </section>
  )
}
