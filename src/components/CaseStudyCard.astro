---
// A single case-study listing card (ADR-001). Links to the deep-dive page at
// /work/<id>. Reads a typed `work` collection entry.
import type { CollectionEntry } from "astro:content";

interface Props {
  /** A `work` collection entry. */
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { title, summary, role, period, metrics } = entry.data;
---

<a
  href={`/work/${entry.id}`}
  class="block rounded-2xl border border-border p-5 motion-safe:transition-colors hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
>
  <h3 class="font-display text-xl font-semibold tracking-tight text-fg">{title}</h3>
  <p class="mt-1 font-mono text-xs uppercase tracking-wider text-muted">{role} · {period}</p>
  <p class="mt-3 leading-relaxed text-muted">{summary}</p>
  {
    metrics.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {metrics.map((metric) => (
          <li class="rounded-full border border-border px-3 py-1 font-mono text-xs text-muted">{metric}</li>
        ))}
      </ul>
    )
  }
</a>
