---
// Renders outbound profile links and an optional PDF résumé download. This is
// the only path off the page (ADR-001). No contact form or contact details
// (ADR-002) — outbound profile links only.
import type { ProfileLink } from "../data/cv.ts";

interface Props {
  /** Outbound profile links. */
  links: ProfileLink[];
  /** Optional path to a downloadable résumé under public/; omit to hide the download. */
  resumePdf?: string;
  /** Optional one-line orientation rendered under the heading. */
  leadIn?: string;
}

const { links, resumePdf, leadIn } = Astro.props;

/** External links open in a new tab and need rel="noopener" for security. */
const isExternal = (url: string) => /^https?:\/\//i.test(url) || url.startsWith("//");
---

<section id="links" aria-labelledby="links-heading" class="reveal cv-section pb-24">
  <h2 id="links-heading" class="cv-eyebrow">
    Links
  </h2>
  {leadIn && <p class="cv-lead">{leadIn}</p>}
  <ul class="mt-8 flex flex-wrap gap-3">
    {
      links.map((link) => (
        <li>
          <a
            href={link.url}
            class="cv-pill text-fg"
            {...(isExternal(link.url)
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
  {
    resumePdf && (
      <p class="mt-8">
        <a
          href={resumePdf}
          download
          class="cv-pill-solid"
        >
          Download résumé (PDF)
        </a>
      </p>
    )
  }
</section>
