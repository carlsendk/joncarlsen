---
// The Credentials section for the full CV (/cv): curated executive signals — CTO
// remit, board roles, scaling, recognition — a core CTO signal (ADR-001). Draft
// `[TODO]` credentials are filtered out via isReady (ADR-003); the section renders
// nothing when no ready credential remains, so it never appears empty (guarded).
import { isReady } from "../data/cv.ts";

interface Props {
  /** Curated executive credentials. isReady-filtered. */
  credentials?: string[];
}

const { credentials = [] } = Astro.props;

// Drop any draft credential still holding the `[TODO]` sentinel (ADR-003).
const shown = credentials.filter(isReady);
---

{
  shown.length > 0 && (
    <section
      aria-labelledby="credentials-heading"
      class="reveal mx-auto max-w-2xl border-t border-border px-6 py-14"
    >
      <h2
        id="credentials-heading"
        class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-muted"
      >
        Credentials
      </h2>
      <ul class="mt-8 space-y-2 leading-relaxed text-muted">
        {shown.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  )
}
