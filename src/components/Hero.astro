---
// Renders the hero/summary: name, current title, and one-line value proposition.
// Above-the-fold banner for the page (ADR-001). Owns the single <h1>.
interface Props {
  /** Full name. */
  name: string;
  /** Current role/title. */
  title: string;
  /** One-line positioning statement. */
  valueProp: string;
  /**
   * Hard executive scope line (org size, transformation reach, remit owned).
   * Supporting text, not a heading — front-loads CTO-level scope (task_04).
   * Optional so the component stays safe until the pages pass it (task_05).
   */
  scope?: string;
}

const { name, title, valueProp, scope } = Astro.props;
---

<header class="mx-auto max-w-2xl px-6 pt-20 pb-12 sm:pt-28">
  <h1 class="font-display text-5xl font-semibold tracking-tight text-fg sm:text-6xl">{name}</h1>
  <p class="mt-3 font-mono text-sm uppercase tracking-[0.2em] text-muted">{title}</p>
  <p class="mt-6 max-w-prose text-lg leading-relaxed text-muted">{valueProp}</p>
  {
    scope && (
      <p class="mt-5 max-w-prose">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Scope</span>
        <span class="mt-1.5 block text-base leading-relaxed text-fg">{scope}</span>
      </p>
    )
  }
</header>
