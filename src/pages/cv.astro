---
// The full CV (/cv) — the deep-evaluation tier of the hub-and-spoke structure
// (ADR-001). Composes the complete CV from the single cvData source: identity
// header, summary, full experience (with bullets), highlights, expertise,
// education, certifications, publications, personal details, and outbound links.
// Reachable in one click from the frontpage; its own shareable URL.
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Summary from "../components/Summary.astro";
import Timeline from "../components/Timeline.astro";
import Impact from "../components/Impact.astro";
import Credentials from "../components/Credentials.astro";
import Approach from "../components/Approach.astro";
import Expertise from "../components/Expertise.astro";
import Education from "../components/Education.astro";
import Certifications from "../components/Certifications.astro";
import Publications from "../components/Publications.astro";
import PersonalDetails from "../components/PersonalDetails.astro";
import VoluntaryLeadership from "../components/VoluntaryLeadership.astro";
import Interests from "../components/Interests.astro";
import CaseStudies from "../components/CaseStudies.astro";
import Links from "../components/Links.astro";
import { cvData } from "../data/cv.ts";
import { leadImpactItems } from "../lib/impact.ts";

const title = `Full CV · ${cvData.name}`;
const description = cvData.valueProp;

// Figures-only band derived from the work collection (first metric per company,
// ADR-004), so the band never repeats the full timeline's descriptive bullets.
const leadImpact = await leadImpactItems();
---

<Base title={title} description={description}>
  <Hero
    name={cvData.name}
    title={cvData.title}
    valueProp={cvData.valueProp}
    scope={cvData.scope}
  />
  <main>
    <Summary summary={cvData.summary} />
    <Credentials credentials={cvData.credentials} />
    <Timeline roles={cvData.roles} variant="full" />
    <Impact items={leadImpact} />
    <Approach about={cvData.about} talks={cvData.talks} />
    <CaseStudies />
    <Expertise expertise={cvData.expertise} />
    <Education education={cvData.education} />
    <Certifications certifications={cvData.certifications} />
    <Publications publications={cvData.publications} />
    <VoluntaryLeadership leadership={cvData.voluntaryLeadership} />
    <PersonalDetails details={cvData.personalDetails} />
    <Interests interests={cvData.interests} />
    <Links links={cvData.links} resumePdf={cvData.resumePdf} />
  </main>
</Base>
