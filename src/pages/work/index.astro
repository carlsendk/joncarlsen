---
// Work index (/work) — the breadth tier of the two-tier project model
// (ADR-002, ADR-003, ADR-005). Lists every non-draft `work` entry grouped by
// company, each linking to its /work/<slug> deep page. The frontpage and /cv
// surface only featured projects; this page exposes the full set. No client JS
// and no contact details (ADR-002).
import Base from "../../layouts/Base.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import { getCollection } from "astro:content";
import { cvData } from "../../data/cv.ts";

// Drop drafts, then group by company. Entries within a company sort by `order`
// (lower first), matching the Selected Work listing. Companies are ordered by
// their most prominent entry (lowest `order`), with the company name as a
// stable, locale-pinned tie-break, so the page is deterministic across builds.
const entries = await getCollection("work", ({ data }) => !data.draft);

const byCompany = new Map<string, typeof entries>();
for (const entry of entries) {
  const group = byCompany.get(entry.data.company) ?? [];
  group.push(entry);
  byCompany.set(entry.data.company, group);
}

const companies = [...byCompany.entries()]
  .map(([company, group]) => ({
    company,
    entries: group.sort((a, b) => a.data.order - b.data.order),
  }))
  .sort(
    (a, b) =>
      a.entries[0].data.order - b.entries[0].data.order ||
      a.company.localeCompare(b.company, "en"),
  );

const companyId = (company: string) =>
  `company-${company.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`;

const title = `Case Studies · ${cvData.name}`;
const description = `Case studies by ${cvData.name}, grouped by company.`;
---

<Base title={title} description={description}>
  <header class="mx-auto max-w-2xl px-6 pt-20 pb-12 sm:pt-28">
    <h1 class="font-display text-5xl font-semibold tracking-tight text-fg sm:text-6xl">Case Studies</h1>
    <p class="cv-body mt-6 max-w-prose text-muted">
      Every project, grouped by company. Each links to its full write-up.
    </p>
  </header>
  <main>
    {
      companies.length > 0 ? (
        companies.map(({ company, entries }) => (
          <section aria-labelledby={companyId(company)} class="reveal cv-section">
            <h2 id={companyId(company)} class="cv-eyebrow">
              {company}
            </h2>
            <ul class="mt-8 space-y-4">
              {entries.map((entry) => (
                <li>
                  <CaseStudyCard entry={entry} />
                </li>
              ))}
            </ul>
          </section>
        ))
      ) : (
        <section class="cv-section">
          <p class="cv-body text-muted">No projects published yet.</p>
        </section>
      )
    }
  </main>
</Base>
