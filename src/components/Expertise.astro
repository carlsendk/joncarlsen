---
// Areas of expertise for the full CV. Reads cvData.expertise. Rendered as a
// scannable set of non-interactive chips.
interface Props {
  /** Areas of expertise. */
  expertise: string[];
}

const { expertise } = Astro.props;
---

<section aria-labelledby="expertise-heading" class="reveal cv-section">
  <h2 id="expertise-heading" class="cv-eyebrow">
    Expertise
  </h2>
  <ul class="mt-8 flex flex-wrap gap-2">
    {
      expertise.map((item) => (
        <li class="cv-badge text-muted">{item}</li>
      ))
    }
  </ul>
</section>
